{
  "name": "keksi",
  "version": "0.1.1",
  "description": "Lean cookie consent for Google and Meta trackers",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "astro"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    },
    "./astro": {
      "types": "./astro/index.d.ts",
      "default": "./astro/index.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit.d.ts",
      "default": "./dist/sveltekit.js"
    },
    "./scan": {
      "types": "./dist/scan.d.ts",
      "default": "./dist/scan.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "pnpm -r --filter './examples/*' test:e2e"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "bin": {
    "keksi": "./dist/cli.js"
  }
}
